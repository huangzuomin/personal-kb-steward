{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-card.schema.json",
  "title": "Canonical seed-card contract (M0)",
  "type": "object",
  "required": [
    "title", "type", "status", "stage", "sources", "summary",
    "confidence", "review_required", "schema_version", "analysis_mode"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "anyOf": [
        {"properties": {"status": {"const": "seed"}, "stage": {"const": "candidate"}}, "required": ["status", "stage"]},
        {"properties": {"status": {"const": "manual_review"}, "stage": {"const": "needs_context"}}, "required": ["status", "stage"]}
      ]
    }
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "seed-card"},
    "status": {"enum": ["seed", "manual_review"]},
    "stage": {"enum": ["candidate", "needs_context"]},
    "sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "summary": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "review_required": {"type": "boolean"},
    "schema_version": {"type": "string", "minLength": 1},
    "generator_version": {"type": ["string", "null"]},
    "analysis_mode": {"enum": ["llm", "heuristic", "heuristic-fallback", "unknown"]},
    "source_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "coverage": {
      "type": ["string", "null"],
      "enum": ["full", "partial", "unknown", null]
    },
    "related": {"type": "array", "items": {"type": "string"}},
    "pending_links": {"type": "array", "items": {"type": "string"}},
    "manual_review": {"type": "array", "items": {"type": "string"}},
    "signals": {"type": "array", "items": {"type": "string"}},
    "growth_directions": {"type": "array", "items": {"type": "string"}},
    "negative_scope": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "quote"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "body_line": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["assertion", "question"]},
          "speaker": {"type": ["string", "null"]},
          "claim_id": {"type": "string"}
        }
      }
    },
    "thought_units": {"type": "array", "items": {"type": "string"}},
    "link_search": {"enum": ["not_attempted", "no_match", "candidates_found"]},
    "is_question": {"type": "boolean"},
    "kind": {"enum": ["question", "assertion"]},
    "statement_sha256": {"type": "string"},
    "thought_id": {"type": "string"},
    "limited_preview": {"type": "boolean"},
    "card_state": {"type": "object"},
    "relation_explanations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
