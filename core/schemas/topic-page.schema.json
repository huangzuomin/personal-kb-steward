{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic-page.schema.json",
  "title": "Canonical topic-page contract (M3/T7, question-led synthesis)",
  "type": "object",
  "required": [
    "title", "type", "status", "stage", "sources", "summary",
    "confidence", "review_required", "schema_version", "analysis_mode",
    "research_question", "theme_boundary", "source_map",
    "tensions", "evidence_gaps", "next_actions", "claims"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "anyOf": [
        {"properties": {"status": {"const": "growing"}, "stage": {"const": "assembling"}}, "required": ["status", "stage"]},
        {"properties": {"status": {"const": "manual_review"}, "stage": {"const": "insufficient"}}, "required": ["status", "stage"]}
      ]
    }
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "topic-page"},
    "status": {"enum": ["growing", "manual_review"]},
    "stage": {"enum": ["assembling", "insufficient"]},
    "sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "summary": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "review_required": {"type": "boolean"},
    "schema_version": {"type": "string", "minLength": 1},
    "generator_version": {"type": ["string", "null"]},
    "analysis_mode": {"enum": ["llm", "heuristic", "heuristic-fallback", "unknown"]},
    "source_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "coverage": {
      "type": ["string", "null"],
      "enum": ["full", "partial", "unknown", null]
    },
    "related": {"type": "array", "items": {"type": "string"}},
    "pending_links": {"type": "array", "items": {"type": "string"}},
    "manual_review": {"type": "array", "items": {"type": "string"}},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "research_question": {"type": "string", "minLength": 1},
    "theme_boundary": {"type": "string"},
    "source_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "provenance", "limitations"],
        "properties": {
          "rel": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string"},
          "provenance": {"type": "string"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "shared_provenance": {"type": "array", "items": {"type": "string"}},
    "supported_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "claim_ids"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "classification"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "classification": {"enum": ["real_conflict", "unverified_tension", "context_difference"]},
          "sources": {"type": "array", "items": {"type": "string"}},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap"],
        "properties": {
          "gap": {"type": "string", "minLength": 1},
          "affected": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "addresses_gap": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {"type": "object"},
      "minItems": 0
    }
  }
}
